    <!-- http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Nghe_an -->

    <owl:Class rdf:about="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Nghe_an">
