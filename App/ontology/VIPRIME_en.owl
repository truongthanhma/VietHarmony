    </owl:Class>
    


    <!-- http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Van_chuong-Tho_ca -->

    <owl:Class rdf:about="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Van_chuong-Tho_ca">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Dong_nhac"/>
        <rdfs:label xml:lang="en">Literature - Poetry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Vinh_long -->

    <owl:Class rdf:about="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Vinh_long">
