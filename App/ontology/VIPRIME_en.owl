    </owl:Class>
    


    <!-- http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Quan_ho -->

    <owl:Class rdf:about="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Quan_ho">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Dan_ca"/>
        <duoc_mo_ta_la xml:lang="en">Quan Ho folk songs are one of the typical folk songs of the Red River Delta in Northern Vietnam. It was formed and developed in the ancient Kinh Bac cultural region, especially the border area of ​​the two provinces of Bac Giang and Bac Ninh today with the Cau River flowing through it, known as &quot;Quan Ho River&quot;.

On September 30, 2009, at the fourth session of the Intergovernmental Committee for the UNESCO Convention for the Safeguarding of Intangible Cultural Heritage (from September 28 to October 2, 2009), Bac Ninh Quan Ho folk songs were recognized as a representative intangible cultural heritage of humanity after Hue royal court music, the space of Gong culture in the Central Highlands and at the same time as Ca Tru.</duoc_mo_ta_la>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Quang_binh -->

    <owl:Class rdf:about="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Quang_binh">
