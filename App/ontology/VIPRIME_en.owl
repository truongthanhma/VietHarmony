    <!-- http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Ca_mau -->

    <owl:Class rdf:about="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Ca_mau">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Dong_bang_song_cuu_long"/>
