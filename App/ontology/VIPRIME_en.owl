    <!-- http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Tuong -->

    <owl:Class rdf:about="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Tuong">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Co_truyen-Dan_gian"/>
        <duoc_mo_ta_la xml:lang="en">Tuong (Nom script: 從), hat boi, hat boi (Nom script: 咭佩) are the names of a popular musical genre in Vietnam. Different from other musical genres such as cheo, cai luong, etc., tuong carries a heroic tone with examples of characters who are loyal to the country, sacrifice themselves for a great cause, lessons about human behavior between the public and the private, between family and the Fatherland, the heroic tragedy is an aesthetic characteristic of Tuong art. It can be said that Tuong is the stage of heroes... This genre is different from social cai luong, Ho Quang cai luong, and dialogue, which are forms of stage performance that were born later.</duoc_mo_ta_la>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Tuyen_quang -->

    <owl:Class rdf:about="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Tuyen_quang">
