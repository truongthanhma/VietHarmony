    </owl:Class>
    


    <!-- http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Ninh_thuan -->

    <owl:Class rdf:about="http://www.semanticweb.org/tranh/ontologies/2023/9/untitled-ontology-19#Ninh_thuan">
